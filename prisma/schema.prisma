// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id              String   @id @default(uuid())
  shop            String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // --- Onboarding State ---
  isOnboarded     Boolean  @default(false)

  // --- Step 1: Packing ---
  timezone        String   @default("Asia/Kolkata")
  cutoffTime      String   @default("14:00") // 24-hr format "HH:mm"
  procMin         Int      @default(1)
  procMax         Int      @default(2)
  oosEnabled      Boolean  @default(true)
  oosDays         Int      @default(10)

  // --- Step 2: Open Days ---
  workingDays     Int[]    @default([1, 2, 3, 4, 5, 6]) // Mon=1 .. Sat=6
  carrierSat      Boolean  @default(false)
  carrierSun      Boolean  @default(false)

  // --- Step 3: Shipping Origin ---
  homeCountry     String   @default("IN")

  // --- Step 5: Placement ---
  widgetPosition  String   @default("below-atc") // "below-atc" | "above-atc" | "below-desc"

  // safety buffers 
  customsClearanceEnabled     Boolean  @default(false)
  customsClearanceDays        Int      @default(2)
  peakSeasonoEnabled          Boolean  @default(false)
  peakSeasonStart             String?
  peakSeasonEnd               String?
  peakSeasonTransitMin        Int      @default(1)
  peakSeasonTransitMax        Int      @default(3)


  // --- Widget Design Settings ---
  dateFormat              String   @default("range")       // "range" | "single" | "days"
  dateStyle               String   @default("full")        // "full" | "medium" | "short" | "day"
  mainLine                String   @default("Get it {date}")
  supportingLine          String   @default("Dispatched from Kolkata")
  fallbackText            String   @default("Enter your postcode for a delivery date")
  showCutoffCountdown     Boolean  @default(true)
  showBreakdown           Boolean  @default(true)
  showDeliveryIcon        Boolean  @default(true)
  hideWhenNoRule          Boolean  @default(false)
  widgetContainer         String   @default("none")        // "none" | "bordered" | "tinted"
  widgetAlignment         String   @default("left")        // "left" | "center"
  widgetIcon              String   @default("van")         // "van" | "box" | "calendar"
  widgetAccentColor       String   @default("#1A5D38")     // Hex color

  // --- Settings ---
  detectionMethod         String   @default("ip")          // "ip"
  locationFallback        String   @default("ask")         // "ask" | "home" | "fallback"

  // --- Relations (Steps 2, 3, 4) ---
  closures        Closure[]
  zones           DeliveryZone[]
  rules           ProductRule[]
}

model Closure {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  reason    String
  createdAt DateTime @default(now())

  @@index([shopId])
}

model DeliveryZone {
  id         String   @id @default(uuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name       String
  countries  String[] // Array of ISO-2 country codes e.g. ["US", "CA"]
  transitMin Int      @default(2)
  transitMax Int      @default(4)
  isHome     Boolean  @default(false)
  isFallback Boolean  @default(false)

  @@index([shopId])
}

model ProductRule {
  id            String   @id @default(uuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  priorityOrder Int      @default(0) // Enforces "first-match-wins" order
  matchField    String   // "type" | "tag" | "title" | "vendor"
  matchOperator String   // "is" | "contains"
  matchValue    String
  behaviour     String   // "estimate" | "merchant" | "hide"
  procMin       Int      @default(0)
  procMax       Int      @default(0)
  isEnabled     Boolean  @default(true)

  @@index([shopId])
}
